{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.anlaunch.launcher",
  "productName": "AnLaunch",
  "directories": {
    "output": "release"
  },
    "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon.png",
    "build/icon.ico",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false,
    "artifactName": "AnLaunch-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AnLaunch"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "public/icon.png",
    "artifactName": "AnLaunch-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png",
    "artifactName": "AnLaunch-${version}.${ext}",
    "category": "Game"
  },
  "publish": {
    "provider": "github",
    "owner": "Daniel-Ohlayan",
    "repo": "AnLaunch"
  }
}
