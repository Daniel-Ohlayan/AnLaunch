{
  "name": "anlaunch",
  "productName": "AnLaunch",
  "private": true,
  "version": "1.0.3",
  "main": "electron/main.js",
  "build": {
    "appId": "com.anlaunch.launcher",
    "productName": "AnLaunch",
    "publish": [
      {
        "provider": "github",
        "owner": "Daniel-Ohlayan",
        "repo": "AnLaunch"
      }
    ]
  },
  "scripts": {
    "dev": "npx vite",
    "dev:vite": "npx vite",
    "preview": "npx vite preview",
    "build": "npx vite build",
    "electron:dev": "node scripts/dev.js",
    "electron:build": "npx vite build && npx electron-builder --config electron-builder.json --win --x64 --publish never && node scripts/ensure-latest-yml.js && node scripts/upload-github-assets.js",
    "electron:start": "npx electron ."
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "clsx": "2.1.1",
    "electron-updater": "^6.6.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
